{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "combaksa-computer-repair",
  "account_id": "bf8c14ae62dc3368c9a511433d861d89",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "combaksa.pe.kr",
      "custom_domain": true
    },
    {
      "pattern": "www.combaksa.pe.kr",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_BUSINESS_EMAIL": "kkyman1947@naver.com",
    "NEXT_PUBLIC_BUSINESS_PHONE": "1660-0596",
    "BUSINESS_PHONE_DAYTIME": "1660-0596",
    "BUSINESS_PHONE_AFTER_HOURS": "070-7917-5281",
    "BUSINESS_TIMEZONE": "Asia/Seoul",
    "BUSINESS_HOURS_START": "09:00",
    "BUSINESS_HOURS_END": "18:00",
    "BUSINESS_HOLIDAYS_KST": "",
    "BUSINESS_CONSULTATION_HOURS_LABEL": "평일·토요일 09:00–18:00 / 야간·공휴일은 접수 상담만 가능합니다.",
    // Keep public after-hours phone routing off until end-to-end testing is complete.
    "AI_PHONE_ROUTING_ENABLED": "false",
    // The Vox webhook is live; keeping this true prevents a later deploy from disabling intake processing.
    "VOX_WEBHOOK_ENABLED": "true",
    "VOX_AGENT_ID": "56416052-f373-45b8-ae59-81ddfa304d4b",
    "VOX_INBOUND_NUMBER": "07079175281",
    "TELEGRAM_NOTIFICATION_ENABLED": "true",
    "TELEGRAM_CONTENT_PROTECTION_ENABLED": "true",
    "TELEGRAM_PII_MODE": "FULL",
    "REQUEST_SUBMISSION_ENABLED": "true",
    // Scheduled runs have no request to derive the admin link from.
    "PUBLIC_BASE_URL": "https://combaksa.pe.kr"
  },
  "secrets": {
    "required": [
      "ADMIN_SESSION_SECRET",
      "REQUEST_ACCESS_SECRET",
      "REQUEST_LOOKUP_SECRET",
      "RATE_LIMIT_SECRET",
      "VOX_WEBHOOK_SECRET",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "STAFF_CHAT_ID_ENCRYPTION_KEY"
    ]
  },
  "triggers": {
    "crons": [
      // Retries notifications the request path could not deliver.
      "*/5 * * * *",
      // Daily D1 backup at 03:00 KST (18:00 UTC), when 접수 traffic is lowest.
      "0 18 * * *"
    ]
  },
  // Holds the daily D1 dumps. Delete rules live on the bucket, not in the
  // Worker: `wrangler r2 bucket lifecycle add` keeps 45 days.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "combaksa-computer-repair-backups"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baroon-computer-repair-db",
      "database_id": "fa1279bd-cfba-4e44-b109-cc30341e47d7",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
